{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "SistemaVentas": "Debug"
    }
  },
  "Database": {
    "ConnectionString": "Data Source=SistemaVentas.Dev.db;Journal Mode=WAL;",
    "CommandTimeoutSeconds": 30,
    "EnableWAL": true
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultTtlSeconds": 60,
    "MaxSizeItems": 500
  },
  "Security": {
    "JwtSecretKey": "DevSecretKey_NOT_FOR_PRODUCTION_32ch",
    "JwtExpiryMinutes": 480,
    "EncryptionKeyBase64": "",
    "EnableInputValidation": true
  },
  "Monitoring": {
    "ApplicationInsightsConnectionString": "",
    "EnableHealthChecks": true,
    "HealthCheckPath": "/health"
  },
  "Api": {
    "BaseUrl": "http://localhost:5000",
    "EnableSwagger": true,
    "EnableRateLimiting": false,
    "RateLimitRequestsPerMinute": 1000
  },
  "Backup": {
    "Enabled": false,
    "BackupPath": "Backups/Dev/",
    "DailyBackupTime": "02:00",
    "RetentionDays": 7
  }
}
