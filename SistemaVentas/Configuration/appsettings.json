{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "SistemaVentas": "Information"
    }
  },
  "Database": {
    "ConnectionString": "Data Source=SistemaVentas.db;Journal Mode=WAL;Cache Size=-20000;",
    "CommandTimeoutSeconds": 30,
    "EnableWAL": true
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultTtlSeconds": 300,
    "MaxSizeItems": 1000
  },
  "Security": {
    "JwtSecretKey": "",
    "JwtExpiryMinutes": 60,
    "EncryptionKeyBase64": "",
    "EnableInputValidation": true
  },
  "Monitoring": {
    "ApplicationInsightsConnectionString": "",
    "EnableHealthChecks": true,
    "HealthCheckPath": "/health"
  },
  "Api": {
    "BaseUrl": "http://localhost:5000",
    "EnableSwagger": true,
    "EnableRateLimiting": true,
    "RateLimitRequestsPerMinute": 60
  },
  "Backup": {
    "Enabled": true,
    "BackupPath": "Backups/",
    "DailyBackupTime": "02:00",
    "RetentionDays": 30
  }
}
