<Window x:Class="SistemaVentas.Views.ReporteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reportes" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <!-- Header -->
        <Border Background="#2C3E50" Padding="20" Height="60" VerticalAlignment="Top">
            <TextBlock Text="Reportes y Análisis" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Foreground="White" />
        </Border>

        <!-- Contenido -->
        <ScrollViewer Margin="0,60,0,0">
            <StackPanel Margin="20">
                <!-- Filtros -->
                <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="0,0,0,15" Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Fecha Inicio" FontWeight="Bold" Margin="0,0,0,5" />
                            <DatePicker SelectedDate="{Binding FechaInicio}" Height="35" Padding="5" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Fecha Fin" FontWeight="Bold" Margin="0,0,0,5" />
                            <DatePicker SelectedDate="{Binding FechaFin}" Height="35" Padding="5" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="20,0,0,0">
                            <Button Command="{Binding GenerarReporteCommand}"
                                    Content="Generar"
                                    Background="#3498DB"
                                    Foreground="White"
                                    Padding="20,10"
                                    FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Métricas -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="#3498DB" BorderThickness="2" Padding="15" Margin="0,0,10,0" Background="#EBF5FB">
                        <StackPanel>
                            <TextBlock Text="Total Ventas" FontWeight="Bold" Foreground="#2C3E50" />
                            <TextBlock Text="{Binding TotalVentas, StringFormat='L {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#3498DB" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#E74C3C" BorderThickness="2" Padding="15" Margin="10,0,10,0" Background="#FADBD8" Grid.Column="1">
                        <StackPanel>
                            <TextBlock Text="Total Premios" FontWeight="Bold" Foreground="#2C3E50" />
                            <TextBlock Text="{Binding TotalPremios, StringFormat='L {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#E74C3C" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#27AE60" BorderThickness="2" Padding="15" Margin="10,0,10,0" Background="#ECFDF5" Grid.Column="2">
                        <StackPanel>
                            <TextBlock Text="Ganancia" FontWeight="Bold" Foreground="#2C3E50" />
                            <TextBlock Text="{Binding Ganancia, StringFormat='L {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#27AE60" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#F39C12" BorderThickness="2" Padding="15" Margin="10,0,0,0" Background="#FEF5E7" Grid.Column="3">
                        <StackPanel>
                            <TextBlock Text="Transacciones" FontWeight="Bold" Foreground="#2C3E50" />
                            <TextBlock Text="{Binding TotalTransacciones}" FontSize="18" FontWeight="Bold" Foreground="#F39C12" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Top Vendedores -->
                <TextBlock Text="Top 10 Vendedores" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding TopVendedores}"
                          AutoGenerateColumns="False"
                          Height="300"
                          Margin="0,0,0,20"
                          Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vendedor" Binding="{Binding Item1}" Width="*" />
                        <DataGridTextColumn Header="Total Ventas" Binding="{Binding Item2, StringFormat='L {0:N2}'}" Width="150" />
                        <DataGridTextColumn Header="# Ventas" Binding="{Binding Item3}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Botones -->
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ExportarCSVCommand}"
                            Content="Exportar CSV"
                            Background="#27AE60"
                            Foreground="White"
                            Padding="20,10"
                            Margin="0,0,10,0"
                            FontWeight="Bold" />
                    <Button Command="{Binding LimpiarCommand}"
                            Content="Limpiar"
                            Background="#95A5A6"
                            Foreground="White"
                            Padding="20,10"
                            FontWeight="Bold" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading -->
        <Border Background="Black" Opacity="0.3"
                Visibility="{Binding Cargando, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Generando reporte..."
                       Foreground="White"
                       FontSize="18"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
