<Window x:Class="SistemaVentas.Views.CajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Caja" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <!-- Header -->
        <Border Background="#2C3E50" Foreground="White" Padding="20" Height="60" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Gestión de Caja" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding SaldoActual, StringFormat='Saldo: L {0:N2}'}" 
                           FontSize="18" Margin="50,0,0,0" Foreground="#2ECC71" FontWeight="Bold" />
            </StackPanel>
        </Border>

        <!-- Contenido -->
        <ScrollViewer Margin="0,60,0,80">
            <StackPanel Margin="20">
                <!-- Tipo de Ajuste -->
                <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="0,0,0,15" Background="White">
                    <StackPanel>
                        <TextBlock Text="Tipo de Ajuste" FontWeight="Bold" Margin="0,0,0,10" />
                        <ComboBox ItemsSource="{Binding Source={x:Static local:CajaViewModel.TiposAjuste}}"
                                  SelectedItem="{Binding TipoAjuste}"
                                  Height="35" Padding="10" />
                    </StackPanel>
                </Border>

                <!-- Monto -->
                <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="0,0,0,15" Background="White">
                    <StackPanel>
                        <TextBlock Text="Monto (L)" FontWeight="Bold" Margin="0,0,0,10" />
                        <TextBox Text="{Binding MontoAjuste}"
                                 Padding="10"
                                 Height="35" />
                    </StackPanel>
                </Border>

                <!-- Motivo -->
                <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="0,0,0,15" Background="White">
                    <StackPanel>
                        <TextBlock Text="Motivo" FontWeight="Bold" Margin="0,0,0,10" />
                        <TextBox Text="{Binding MotivoAjuste}"
                                 Padding="10"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True" />
                    </StackPanel>
                </Border>

                <!-- Historial -->
                <TextBlock Text="Historial del Día" FontWeight="Bold" FontSize="14" Margin="0,20,0,10" />
                <DataGrid ItemsSource="{Binding Movimientos}"
                          AutoGenerateColumns="False"
                          Height="200"
                          Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Item1}" Width="*" />
                        <DataGridTextColumn Header="Monto" Binding="{Binding Item2, StringFormat='L {0:N2}'}" Width="100" />
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Item3}" Width="150" />
                        <DataGridTextColumn Header="Hora" Binding="{Binding Item4, StringFormat='HH:mm:ss'}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Height="70" Background="White" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="20">
            <Button Command="{Binding LimpiarCommand}"
                    Content="Limpiar"
                    Background="#95A5A6"
                    Foreground="White"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    FontWeight="Bold" />
            <Button Command="{Binding AgregarAjusteCommand}"
                    Content="Guardar Ajuste"
                    Background="#27AE60"
                    Foreground="White"
                    Padding="20,10"
                    FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
