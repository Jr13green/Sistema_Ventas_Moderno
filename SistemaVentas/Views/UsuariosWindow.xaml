<Window x:Class="SistemaVentas.Views.UsuariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Usuarios" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <!-- Header -->
        <Border Background="#2C3E50" Foreground="White" Padding="20" Height="60" VerticalAlignment="Top">
            <TextBlock Text="Gestión de Usuarios" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
        </Border>

        <!-- Contenido -->
        <Grid Margin="0,60,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Panel Crear Usuario -->
            <Border Background="White" BorderBrush="#DDD" BorderThickness="0,0,1,0" Padding="20" Margin="0,0,0,80">
                <StackPanel>
                    <TextBlock Text="Crear Nuevo Usuario" FontWeight="Bold" FontSize="14" Margin="0,0,0,20" />

                    <TextBlock Text="Nombre Completo" FontWeight="Bold" Margin="0,0,0,5" />
                    <TextBox Text="{Binding NombreNuevo}" Padding="10" Height="35" Margin="0,0,0,15" />

                    <TextBlock Text="Número de Contacto" FontWeight="Bold" Margin="0,0,0,5" />
                    <TextBox Text="{Binding NumeroNuevo}" Padding="10" Height="35" Margin="0,0,0,15" />

                    <TextBlock Text="Rol" FontWeight="Bold" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Source={x:Static local:Roles}}"
                              SelectedItem="{Binding RolSeleccionado}"
                              Height="35" Margin="0,0,0,20" Padding="10" />

                    <Button Command="{Binding CrearUsuarioCommand}"
                            Content="Crear Usuario"
                            Background="#27AE60"
                            Foreground="White"
                            Padding="10"
                            Height="40"
                            FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- DataGrid de Usuarios -->
            <StackPanel Grid.Column="1" Margin="20,0,20,80">
                <TextBlock Text="Usuarios Activos" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding UsuariosActivos}"
                          AutoGenerateColumns="False"
                          Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                        <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="*" />
                        <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="120" />
                        <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="100" />
                        <DataGridTemplateColumn Header="Acción" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Eliminar"
                                            Command="{Binding DataContext.EliminarUsuarioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding Id}"
                                            Background="#E74C3C"
                                            Foreground="White"
                                            Padding="5" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <!-- Botones Inferiores -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Height="70" Background="White" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="20" Grid.ColumnSpan="2">
                <Button Command="{Binding CargarUsuariosCommand}"
                        Content="Recargar"
                        Background="#3498DB"
                        Foreground="White"
                        Padding="20,10"
                        FontWeight="Bold" />
            </StackPanel>
        </Grid>

        <!-- Loading -->
        <Border Background="Black" Opacity="0.3"
                Visibility="{Binding Cargando, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Procesando..."
                       Foreground="White"
                       FontSize="18"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
