{
  "Environment": "Staging",
  "ConnectionStrings": {
    "Default": "Data Source=staging_ventas.db"
  },
  "Security": {
    "JwtSecretKey": "CHANGE_ME_IN_DEPLOYMENT_STAGING_KEY_MIN_32_CHARS",
    "JwtExpirationMinutes": 60
  },
  "Api": {
    "AllowedOrigins": ["https://staging.sistemaventas.app"],
    "EnableRateLimiting": true,
    "RateLimitRequestsPerMinute": 120,
    "RequireApiKey": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
