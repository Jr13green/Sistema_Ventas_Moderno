{
  "Environment": "Production",
  "ConnectionStrings": {
    "Default": "Data Source=/data/ventas.db"
  },
  "Security": {
    "JwtSecretKey": "CHANGE_ME_IN_DEPLOYMENT_PRODUCTION_KEY_MIN_32_CHARS",
    "JwtExpirationMinutes": 30
  },
  "Api": {
    "AllowedOrigins": ["https://sistemaventas.app", "https://www.sistemaventas.app"],
    "EnableRateLimiting": true,
    "RateLimitRequestsPerMinute": 60,
    "RequireApiKey": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
